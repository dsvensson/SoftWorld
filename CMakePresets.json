{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"SW_WARNINGS_AS_ERRORS": "ON"
			}
		},
		{
			"name": "windows",
			"hidden": true,
			"inherits": "base",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "macos",
			"hidden": true,
			"inherits": "base",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
		},
		{
			"name": "linux",
			"hidden": true,
			"inherits": "base",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_LINKER_TYPE": "LLD" }
		},
		{
			"name": "msvc-v4",
			"displayName": "MSVC, x86-64-v4 (AVX-512)",
			"inherits": "windows",
			"cacheVariables": { "CMAKE_C_COMPILER": "cl", "SW_ARCH": "x86-64-v4" }
		},
		{
			"name": "msvc-v3",
			"displayName": "MSVC, x86-64-v3 (AVX2)",
			"inherits": "windows",
			"cacheVariables": { "CMAKE_C_COMPILER": "cl", "SW_ARCH": "x86-64-v3" }
		},
		{
			"name": "msvc-generic",
			"displayName": "MSVC, baseline x86-64",
			"inherits": "windows",
			"cacheVariables": { "CMAKE_C_COMPILER": "cl", "SW_ARCH": "generic" }
		},
		{
			"name": "msvc-asan",
			"displayName": "MSVC, x86-64-v4, AddressSanitizer (Debug only)",
			"inherits": "windows",
			"cacheVariables": { "CMAKE_C_COMPILER": "cl", "SW_ARCH": "x86-64-v4", "SW_ASAN": "ON" }
		},
		{
			"name": "clangcl-v4",
			"displayName": "clang-cl + lld-link, x86-64-v4 (AVX-512)",
			"inherits": "windows",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_LINKER_TYPE": "LLD",
				"SW_ARCH": "x86-64-v4"
			}
		},
		{
			"name": "macos-m3",
			"displayName": "Apple clang, Apple M3 and later (NEON)",
			"inherits": "macos",
			"cacheVariables": { "SW_ARCH": "apple-m3" }
		},
		{
			"name": "macos-generic",
			"displayName": "Apple clang, arm64, scalar kernels",
			"inherits": "macos",
			"cacheVariables": { "SW_ARCH": "generic" }
		},
		{
			"name": "linux-v4",
			"displayName": "clang + lld, x86-64-v4 (AVX-512)",
			"inherits": "linux",
			"cacheVariables": { "SW_ARCH": "x86-64-v4" }
		},
		{
			"name": "linux-v3",
			"displayName": "clang + lld, x86-64-v3 (AVX2)",
			"inherits": "linux",
			"cacheVariables": { "SW_ARCH": "x86-64-v3" }
		},
		{
			"name": "linux-generic",
			"displayName": "clang + lld, baseline x86-64 or arm64, scalar kernels",
			"inherits": "linux",
			"cacheVariables": { "SW_ARCH": "generic" }
		}
	],
	"buildPresets": [
		{ "name": "msvc-v4", "configurePreset": "msvc-v4", "configuration": "Release" },
		{ "name": "msvc-v4-debug", "configurePreset": "msvc-v4", "configuration": "Debug" },
		{ "name": "msvc-v3", "configurePreset": "msvc-v3", "configuration": "Release" },
		{ "name": "msvc-v3-debug", "configurePreset": "msvc-v3", "configuration": "Debug" },
		{ "name": "msvc-generic", "configurePreset": "msvc-generic", "configuration": "Release" },
		{ "name": "msvc-asan", "configurePreset": "msvc-asan", "configuration": "Debug" },
		{ "name": "clangcl-v4", "configurePreset": "clangcl-v4", "configuration": "Release" },
		{ "name": "clangcl-v4-debug", "configurePreset": "clangcl-v4", "configuration": "Debug" },
		{ "name": "macos-m3", "configurePreset": "macos-m3", "configuration": "Release" },
		{ "name": "macos-m3-debug", "configurePreset": "macos-m3", "configuration": "Debug" },
		{ "name": "macos-generic", "configurePreset": "macos-generic", "configuration": "Release" },
		{ "name": "macos-generic-debug", "configurePreset": "macos-generic", "configuration": "Debug" },
		{ "name": "linux-v4", "configurePreset": "linux-v4", "configuration": "Release" },
		{ "name": "linux-v4-debug", "configurePreset": "linux-v4", "configuration": "Debug" },
		{ "name": "linux-v3", "configurePreset": "linux-v3", "configuration": "Release" },
		{ "name": "linux-v3-debug", "configurePreset": "linux-v3", "configuration": "Debug" },
		{ "name": "linux-generic", "configurePreset": "linux-generic", "configuration": "Release" },
		{ "name": "linux-generic-debug", "configurePreset": "linux-generic", "configuration": "Debug" }
	],
	"testPresets": [
		{ "name": "msvc-v4", "configurePreset": "msvc-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "clangcl-v4", "configurePreset": "clangcl-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "msvc-v4-maps", "configurePreset": "msvc-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } },
		{ "name": "msvc-v3", "configurePreset": "msvc-v3", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "msvc-v3-maps", "configurePreset": "msvc-v3", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } },
		{ "name": "macos-m3", "configurePreset": "macos-m3", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "macos-m3-maps", "configurePreset": "macos-m3", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } },
		{ "name": "macos-generic", "configurePreset": "macos-generic", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "macos-generic-maps", "configurePreset": "macos-generic", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } },
		{ "name": "linux-v4", "configurePreset": "linux-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "linux-v4-maps", "configurePreset": "linux-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } },
		{ "name": "linux-v3", "configurePreset": "linux-v3", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "linux-v3-maps", "configurePreset": "linux-v3", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } },
		{ "name": "linux-generic", "configurePreset": "linux-generic", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "linux-generic-maps", "configurePreset": "linux-generic", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } }
	]
}

{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"SW_WARNINGS_AS_ERRORS": "ON"
			}
		},
		{
			"name": "msvc-v4",
			"displayName": "MSVC, x86-64-v4 (AVX-512)",
			"inherits": "base",
			"cacheVariables": { "CMAKE_C_COMPILER": "cl", "SW_ARCH": "x86-64-v4" }
		},
		{
			"name": "msvc-generic",
			"displayName": "MSVC, baseline x86-64",
			"inherits": "base",
			"cacheVariables": { "CMAKE_C_COMPILER": "cl", "SW_ARCH": "generic" }
		},
		{
			"name": "msvc-asan",
			"displayName": "MSVC, x86-64-v4, AddressSanitizer (Debug only)",
			"inherits": "base",
			"cacheVariables": { "CMAKE_C_COMPILER": "cl", "SW_ARCH": "x86-64-v4", "SW_ASAN": "ON" }
		},
		{
			"name": "clangcl-v4",
			"displayName": "clang-cl + lld-link, x86-64-v4 (AVX-512)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_LINKER_TYPE": "LLD",
				"SW_ARCH": "x86-64-v4"
			}
		}
	],
	"buildPresets": [
		{ "name": "msvc-v4", "configurePreset": "msvc-v4", "configuration": "Release" },
		{ "name": "msvc-v4-debug", "configurePreset": "msvc-v4", "configuration": "Debug" },
		{ "name": "msvc-generic", "configurePreset": "msvc-generic", "configuration": "Release" },
		{ "name": "msvc-asan", "configurePreset": "msvc-asan", "configuration": "Debug" },
		{ "name": "clangcl-v4", "configurePreset": "clangcl-v4", "configuration": "Release" },
		{ "name": "clangcl-v4-debug", "configurePreset": "clangcl-v4", "configuration": "Debug" }
	],
	"testPresets": [
		{ "name": "msvc-v4", "configurePreset": "msvc-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "clangcl-v4", "configurePreset": "clangcl-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "exclude": { "label": "maps" } } },
		{ "name": "msvc-v4-maps", "configurePreset": "msvc-v4", "configuration": "Release", "output": { "outputOnFailure": true },
			"filter": { "include": { "label": "maps" } } }
	]
}
